{
  "manifest_version": 1,
  "tool_id": "audio-editor",
  "version": "1.0.0",
  "name": "音频编辑",
  "description": "截取音频、调整音量，叠加配乐并添加淡入淡出。",
  "category": "媒体工具",
  "tags": [
    "音频",
    "截取",
    "混音",
    "音量",
    "淡入淡出"
  ],
  "execution_target": "backend",
  "supported_modes": [
    "desktop",
    "source-web",
    "docker-web"
  ],
  "required_capabilities": [],
  "dependencies": [],
  "operations": [
    {
      "operation_id": "edit",
      "title": "生成音频",
      "description": "优先用媒体源目录选择已授权音频源并传 artifact_id。若当前对话中的用户任务已明确给出本机文件路径和音频处理动作，不要重复询问授权，直接按指令调用，并将相关用户原话填入 user_authorization。只有路径、动作或处理范围确实不清楚或冲突时，才询问缺少的信息；不得扩展到其他文件或操作。路径模式无需 MTools 二次审批。按秒截取音频，可调整音量 0–4 倍，按秒偏移叠加另一段音频并淡入淡出；以主音频时长为准，输出 MP3/WAV；源文件只读，结果另存。",
      "ai_authorization": "conversation",
      "effects": "write",
      "ai_callable": true,
      "contract_version": 1,
      "input_schema": "#/components/schemas/AudioEdit",
      "output_schema": "#/components/schemas/Job",
      "execution": "job",
      "cancellable": true,
      "idempotent": false,
      "timeout_seconds": 20,
      "max_input_bytes": 16000
    }
  ],
  "ui": {
    "route": "/tools/audio-editor"
  },
  "docs": {
    "overview": "docs/features/media-tools/overview.md",
    "usage": "docs/features/media-tools/usage.md"
  }
}
